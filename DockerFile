# ============================================================
# Stage 1: build — install all dependencies and build the frontend
# ============================================================
FROM node:22-alpine AS build
WORKDIR /app

# Copy only the dependency files first, so this layer is cached
# and npm ci re-runs only when dependencies change
COPY package.json package-lock.json ./
RUN npm ci

# Copy the source code and build the React app into dist/
COPY . .
RUN npm run build

# ============================================================
# Stage 2: deps — production dependencies only (no Vite, ESLint, tests)
# ============================================================
FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# ============================================================
# Stage 3: runtime — the small final image that actually runs
# ============================================================
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000

# Only what the server needs at runtime
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY server ./server
COPY --from=build /app/dist ./dist

# Run as the built-in non-root "node" user
USER node

EXPOSE 3000

# Docker marks the container unhealthy if /api/health stops answering
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3000) + '/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server/index.js"]